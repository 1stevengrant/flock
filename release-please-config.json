{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "include-component-in-tag": false,
  "bootstrap-sha": "c8974be54c1c149ba88114a6721966561e39f572",
  "pull-request-header": "Pending release",
  "draft-pull-request": false,
  "pull-request-footer": "\"Merge when ready\" puts this PR in the merge queue, which builds and signs it for macOS and Windows. Only if those builds pass is it merged, which tags this version, creates a GitHub release and attaches those builds to it.",
  "packages": {
    ".": {
      "release-type": "go",
      "initial-version": "1.0.0",
      "changelog-path": "CHANGELOG.md",
      "changelog-sections": [
        { "type": "feat", "section": "Features" },
        { "type": "fix", "section": "Bug Fixes" },
        { "type": "perf", "section": "Performance" },
        { "type": "refactor", "section": "Refactor" },
        { "type": "style", "section": "Style" },
        { "type": "revert", "section": "Reverts" },
        { "type": "docs", "section": "Documentation", "hidden": true },
        { "type": "test", "section": "Tests", "hidden": true },
        { "type": "chore", "section": "Chore", "hidden": true },
        { "type": "ci", "section": "CI", "hidden": true },
        { "type": "build", "section": "Build", "hidden": true }
      ]
    }
  }
}
